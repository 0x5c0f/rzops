# ============================================================
# RzOps CMDB 环境变量模板
# 复制为 .env 后按需修改；docker compose 启动时自动读取。
# ============================================================

# ---- Postgres（compose 服务 db）----
POSTGRES_USER=rzops
POSTGRES_PASSWORD=rzops
POSTGRES_DB=rzopsdb
POSTGRES_PORT=5432

# ---- 对外端口 ----
API_PORT=8000
WEB_PORT=8080

# ---- API 服务（RZOPS_ 前缀，双下划线为嵌套层级）----
RZOPS_SERVER__HOST=0.0.0.0
RZOPS_SERVER__PORT=8000

RZOPS_DATABASE__HOST=db
RZOPS_DATABASE__PORT=5432
RZOPS_DATABASE__USER=rzops
RZOPS_DATABASE__PASSWORD=rzops
RZOPS_DATABASE__NAME=rzopsdb

# JWT 签名密钥（生产必须更换为随机长字符串）
RZOPS_JWT__SECRET=dev-only-secret-change-me
RZOPS_JWT__EXPIRATION_SECONDS=86400

# 首次启动自动创建的超级管理员（后端 seeder 保证幂等）
RZOPS_SEED_ADMIN_EMAIL=admin@rzops.local
RZOPS_SEED_ADMIN_PASSWORD=admin123

# ---- 前端（仅本地 vite dev / preview 公网反代开发时使用）----
# 通过公网域名反代或内网穿透访问 vite dev server 时设置（如 cmdb.example.com），
# 用于 allowedHosts 白名单并自动禁用 HMR；由 rzops-web/.env 或环境变量提供，
# compose 的 web 服务为静态构建（nginx 托管），不受此变量影响。
RZOPS_PUBLIC_HOST=

# ---- 本机直连数据库（sqlx-cli / psql 手动操作时使用）----
DATABASE_URL=postgres://rzops:rzops@localhost:5432/rzopsdb
