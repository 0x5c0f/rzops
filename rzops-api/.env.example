# RzOps API Environment Variables

# Server
RZOPS_SERVER__HOST=0.0.0.0
RZOPS_SERVER__PORT=8000

# Database
RZOPS_DATABASE__HOST=localhost
RZOPS_DATABASE__PORT=5432
RZOPS_DATABASE__USER=rzops
RZOPS_DATABASE__PASSWORD=changeme
RZOPS_DATABASE__NAME=rzops

# Direct database URL (for sqlx-cli migrations)
DATABASE_URL=postgres://rzops:changeme@localhost:5432/rzops

# JWT — CHANGE THIS IN PRODUCTION
RZOPS_JWT__SECRET=change-me-to-a-random-secret
RZOPS_JWT__EXPIRATION_SECONDS=86400

# Seed admin user (created on first startup if not exists)
RZOPS_SEED_ADMIN_EMAIL=admin@rzops.local
RZOPS_SEED_ADMIN_PASSWORD=change-me
