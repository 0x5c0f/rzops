# ============================================================
# RzOps API 环境变量模板（后端单独运行时使用，如 cargo run）
# 复制为 rzops-api/.env 后按需修改；后端启动时由 dotenvy 自动加载。
# 注意：docker compose 方式启动时请使用根目录 .env（本文件不参与）。
# 取值与根目录 .env.example 保持一致（本机直连数据库时用 localhost）。
# ============================================================

# ---- Server ----
RZOPS_SERVER__HOST=0.0.0.0
RZOPS_SERVER__PORT=8000

# ---- Database（本机直连）----
RZOPS_DATABASE__HOST=localhost
RZOPS_DATABASE__PORT=5432
RZOPS_DATABASE__USER=rzops
RZOPS_DATABASE__PASSWORD=rzops
RZOPS_DATABASE__NAME=rzopsdb

# 本机直连数据库 URL（sqlx-cli / psql 手动操作时使用）
DATABASE_URL=postgres://rzops:rzops@localhost:5432/rzopsdb

# ---- JWT（生产必须更换为随机长字符串）----
RZOPS_JWT__SECRET=dev-only-secret-change-me
RZOPS_JWT__EXPIRATION_SECONDS=86400

# ---- Seed admin（首次启动自动创建的超级管理员，seeder 幂等）----
RZOPS_SEED_ADMIN_EMAIL=admin@rzops.local
RZOPS_SEED_ADMIN_PASSWORD=admin123
